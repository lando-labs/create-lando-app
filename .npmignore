# Belt-and-suspenders to the package.json `files` allowlist.
# `files` already constrains what ships; this keeps `npm pack --dry-run` clean.

# Source & dev scripts — only dist/ and templates/ ship.
src/
scripts/

# Configs & CI
.github/
.claude/
tsconfig*.json
*.tsbuildinfo

# Dev artifacts
*.log
*.tgz
.DS_Store
